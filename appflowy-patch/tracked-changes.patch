+    debugPrint('DEBUG: Intercepting command $command');
+    try {
+      final text = editorState.getTextInSelection(selection);
+      debugPrint('DEBUG: Selection text length: ${text.length}');
+      if (text.isEmpty) {
+         debugPrint('DEBUG: Text is empty, returning');
+         return;
+      }
+      
+      final joinedText = text.join('\n');
+      String result;
+      
+      if (command == AiWriterCommand.summarize) {
+        result = await AIPluginService.summarize(joinedText);
+      } else {
+        result = await AIPluginService.improveWriting(joinedText);
+      }
+      
+      final transaction = editorState.transaction
+        ..replaceText(
+          editorState.getNodeAtPath(selection.start.path)!, 
+          selection.startIndex, 
+          selection.length, 
+          result
+        );
+        
+      await editorState.apply(transaction);
+      return;
+    } catch (e, stack) {
+      // Fallback or error handling
+      debugPrint('AI Plugin Error (Falling back to legacy): $e\n$stack');
+      // showToastNotification(message: 'AI Plugin Failed: $e'); // Optional: notify user
+    }
+  }
+
+  // Default behavior (use Rust AI backend)
   final transaction = editorState.transaction
     ..insertNode(
       selection.end.path.next,
