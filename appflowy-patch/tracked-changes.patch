+  bool _handleAgentAction(String text) {
+    try {
+      final data = json.decode(text);
+      if (data is Map && data.containsKey('action_type')) {
+        final actionType = data['action_type'];
+        if (actionType == 'create_database') {
+          final name = data['name'] ?? 'New Database';
+          _aiWriterCubitLog('Creating database: $name');
+          ViewBackendService.createView(
+            layoutType: ViewLayoutPB.Grid,
+            parentViewId: documentId,
+            name: name,
+          ).then((result) {
+            result.fold(
+              (view) => _aiWriterCubitLog('Database $name created successfully'),
+              (error) => _aiWriterCubitLog('Failed to create database $name: $error'),
+            );
+          });
+          return true;
+        } else if (actionType == 'insert_block') {
+          final content = data['message'] ?? '';
+          if (content.isNotEmpty) {
+            _aiWriterCubitLog('Inserting block: $content');
+            final selection = editorState.selection;
+            final transaction = editorState.transaction;
+            if (selection != null) {
+              transaction.insertNode(
+                selection.end.path.next,
+                paragraphNode(text: content),
+              );
+            } else {
+              // Fallback: insert at end of document
+              final lastNodePath = [editorState.document.root.children.length];
+              transaction.insertNode(
+                lastNodePath,
+                paragraphNode(text: content),
+              );
+            }
+            editorState.apply(transaction).then((_) {
+              _aiWriterCubitLog('Block inserted successfully via collab transaction');
+            });
+          }
+          return true;
+        }
+      }
+    } catch (e) {
+      // Ignored
+    }
+    return false;
+  }
